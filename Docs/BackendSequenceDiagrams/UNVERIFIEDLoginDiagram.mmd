sequenceDiagram
    participant Client

    box Backend
        participant AuthService
        participant DB
    end

    alt Login
        Client->>AuthService: POST /auth/login
        AuthService->>DB: Lookup user by username
        DB-->>AuthService: User row
        AuthService->>AuthService: bcrypt.verify(password, hash)
        AuthService-->>Client: 401 (retry) or 200 + session cookie

    else Register
        Client->>AuthService: POST /auth/register
        AuthService->>DB: Check username + INSERT
        DB-->>AuthService: OK or conflict
        AuthService-->>Client: 409 (retry) or 201 + session cookie
    end